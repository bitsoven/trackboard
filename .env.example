# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
# sqlite for local/test (default), pg/postgres for home-lab Postgres
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=trackboard

# Storage — S3 compatible (MinIO)
DRIVE_DISK=fs
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=trackboard
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true

# Mail — SMTP / Resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Trackboard"
RESEND_API_KEY=

# Reply-to address domain for inbound email threading (ticket-<token>@<domain>)
REPLY_TO_DOMAIN=
# Shared secret for the inbound-email webhook (optional; if set, requests must send x-webhook-secret
WEBHOOK_SECRET=
